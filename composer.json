{
    "name": "tenant/flood",
    "description": "Multi-tenancy for Laravel.",
    "license": "MIT",
    "authors": [
        {
            "name": "Ankit Shah"
        }
    ],
    "require": {
        "php": "^7.1",
        "illuminate/support": "^5.5 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "Flood\\Tenant\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Flood\\Tenant\\Providers\\TenantServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
